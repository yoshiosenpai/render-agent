# Settings for the Marketing Hub render helper. install.sh copies this to render-agent.env
# (which git ignores). Type secrets in yourself; never paste them into a chat.

# The Hub, and the token that must match RENDER_TOKEN in the Hub's .env.
HUB_URL=https://marketinghub.cytron.io
RENDER_TOKEN=

# How many videos are made at once (1 to 4). Never two for the same script.
RENDER_JOBS=2

# Claude Code: signed in with the Claude subscription (run `claude` once), or a separate
# Anthropic API key just for this machine (pay per use, no subscription limits; easy to track).
# ANTHROPIC_API_KEY=
# Optional: a faster model for building videos (e.g. sonnet). Empty = Claude Code's default.
CLAUDE_MODEL=

# Where each video's code is kept between jobs (one folder per video). Empty = ~/hub-video-work
# WORK_DIR=

# Gentle on the machine: priority, and (optional) limits install.sh puts on the service.
RENDER_NICE=10
# RENDER_MEMORY_MAX_MB=16384
# RENDER_CPU_PERCENT=600

# How long Claude Code may work on one job, and how long a render may take (minutes).
CLAUDE_MAX_TURNS=80
BUILD_TIMEOUT_MIN=30
RENDER_TIMEOUT_MIN=40

# How often to ask the Hub for work (seconds), and the name the Hub shows for this machine.
POLL_SECONDS=15
MACHINE_NAME=render-box

# Leave empty to find them on the PATH.
CLAUDE_BIN=
CHROMIUM_PATH=
