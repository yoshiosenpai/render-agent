# Settings for the Marketing Hub render helper. install.sh copies this to render-agent.env.
# Type the token yourself (never paste it into a chat); it must match RENDER_TOKEN in the Hub's .env.

# The Hub. The public address works from anywhere; the Pi's LAN address also works on the office network.
HUB_URL=https://marketinghub.cytron.io
RENDER_TOKEN=

# The Remotion project on this machine.
REMOTION_DIR=/home/asri/Desktop/marketing-hub

# Kept gentle so ChirpStack and the rest of the machine stay responsive.
RENDER_CONCURRENCY=2
RENDER_NICE=15

# How long Claude Code may work on one job, and how long a render may take (minutes).
CLAUDE_MAX_TURNS=60
BUILD_TIMEOUT_MIN=25
RENDER_TIMEOUT_MIN=30

# How often to ask the Hub for work (seconds), and the name the Hub shows for this machine.
POLL_SECONDS=15
MACHINE_NAME=render-box

# Leave empty to use `claude` from the PATH.
CLAUDE_BIN=
